# Pick ONE provider: groq | gemini | ollama | mock
# If LLM_PROVIDER is empty, the app auto-selects: GROQ_API_KEY -> groq, GEMINI_API_KEY -> gemini, otherwise mock.
LLM_PROVIDER=

GROQ_API_KEY=
GROQ_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

OLLAMA_HOST=
OLLAMA_MODEL=

# Max generate -> validate -> retry rounds per language (default 3)
MAX_ATTEMPTS=3
